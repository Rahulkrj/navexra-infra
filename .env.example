# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit the resulting .env file.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=change-me-to-a-strong-passphrase
POSTGRES_DB=appdb

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-passphrase

# ── MongoDB (root user, used by the mongodb service itself) ──
MONGO_USER=mongoroot
MONGO_PASSWORD=change-me-to-a-strong-passphrase
MONGO_DB=reportify

# ── MongoDB (dedicated least-privilege user for pbm-agent) ───
# Create this user once via mongosh (see db-backup-scripts/setup-pbm.sh)
# before starting the pbm-agent service.
PBM_MONGO_USER=pbmbackup
PBM_MONGO_PASSWORD=change-me-to-a-strong-passphrase
