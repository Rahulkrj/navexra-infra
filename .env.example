# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit the resulting .env file.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=change-me-to-a-strong-passphrase
POSTGRES_DB=appdb

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-passphrase

# ── MongoDB (root user, used by the mongodb service itself) ──
MONGO_USER=mongoroot
MONGO_PASSWORD=change-me-to-a-strong-passphrase
MONGO_DB=reportify

# ── MongoDB (dedicated least-privilege user for pbm-agent) ───
# Set these BEFORE `docker compose up -d pbm-agent` (it needs them to build
# its connection string). The actual Mongo user with these credentials gets
# created afterwards by db-backup-scripts/setup-pbm.sh — run that next.
# No R2 credentials belong here: setup-pbm.sh reads those itself from
# ~/.config/rclone/rclone.conf (already written by setup-r2.sh) and from
# backup-to-r2.sh's R2_BUCKET= line, so they're never duplicated into .env.
PBM_MONGO_USER=pbmbackup
PBM_MONGO_PASSWORD=change-me-to-a-strong-passphrase
